# Copy to .env and adjust. Never commit the real .env.

# App connection string (SQLAlchemy URL, psycopg2 driver)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:57772590@localhost:5432/image_registry

# Used by pytest only; a separate database so tests never touch real data
TEST_DATABASE_URL=postgresql+psycopg2://postgres:57772590@localhost:5432/image_registry_test

# Image storage and validation
STORAGE_DIR=./data/images
MAX_UPLOAD_BYTES=524288000

# Max Hamming distance (out of 64 bits) for two images to count as "similar"
HAMMING_THRESHOLD=10